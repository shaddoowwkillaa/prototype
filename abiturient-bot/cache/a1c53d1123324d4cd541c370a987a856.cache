                    <div class="title"><div class="content"><h1 class="title" id="page-title">Списки зачисленных</h1></div></div>
            
  <div id="main-wrapper"><div id="main" class="clearfix">

      <a id="main-content"></a>


    

    <div id="content" class="column"><div class="section">
      
                    <div class="tabs"></div>
